# Required for a production deployment. Never commit a real value.
DATABASE_URL=postgresql://pharmaerp:change-me@localhost:5433/pharmaerp
ERP_API_KEY=replace-with-a-32-character-random-secret
# Server-only values: never prefix with NEXT_PUBLIC_ and never commit the secret.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
NODE_ENV=production

# --- Local development only (never set in production) ---
# Set ERP_ALLOW_MOCK_AUTH=true to enable offline mock login when Supabase is not configured.
# Mock login accepts any password >=8 chars for ERP_MOCK_ADMIN_EMAIL.
ERP_ALLOW_MOCK_AUTH=false
ERP_MOCK_ADMIN_EMAIL=admin@borgangdrugdistributors.com
